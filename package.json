    "@tailwindcss/typography": "^0.5.20",
    "@types/mdx": "^2.0.14",
    "@vercel/speed-insights": "^2.0.0",
    "chart.js": "^4.5.1",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
